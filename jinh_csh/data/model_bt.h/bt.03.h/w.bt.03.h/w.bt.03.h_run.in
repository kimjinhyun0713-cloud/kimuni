
log w.bt.03.h.log
units real
atom_style full
box tilt large
read_data w.bt.03.h.data
include w.bt.03.h_coeff.in

replicate 1 1 1
# neigh_modify every 1 delay 0 check yes  #n every 1 delay 10
group             solution type 6 7
dump              1 all custom 1000 w.bt.03.h.lammpstrj id type element x y z
dump_modify       1 element Si Ca O O H O H sort id
# fix               s all shake 0.0001 10 0 b 1 2 a 1 2

variable          T equal 100
velocity          all create ${T} 777
thermo            1000
thermo_style      custom step temp etotal pe press vol&
                  cella cellb cellc cellalpha cellbeta cellgamma density

# equilibrium run  with short time step
minimize          1e-4 1e-6 30 1000
timestep          0.01
fix               solution all npt temp  ${T} 300  1 aniso 1 1 10
fix               c all recenter INIT INIT INIT
run               100000
unfix             solution
write_restart     restart.*

timestep          0.1
fix               solution all npt temp 300 300 10 aniso 1 1 100
run               100000

write_data        compute_w.bt.03.h.data
write_restart     restart.*
